# ==============================================================================
# VOUCHAIN (CREDENT) — MONOREPO ENVIRONMENT TEMPLATE
# Copy to .env or run `bun run env:sync` to propagate across services.
# NEVER commit real keys or .env files to git!
# ==============================================================================

# Network & RPC
MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
CHAIN_ID=10143

# Databases & Cache
DATABASE_URL="postgres://postgres:password@localhost:5432/vouchain"
REDIS_URL="redis://localhost:6379"

# Service Ports & Local URLs
PORT_FRONTEND=3000
PORT_API=3001
PORT_PLATFORM_SIM=3002
PORT_AGENTS=3003
PORT_INDEXER=3111

API_URL="http://localhost:3001"
PLATFORM_SIM_URL="http://localhost:3002"
AGENTS_SERVICE_URL="http://localhost:3003"
INDEXER_URL="http://localhost:3111"

# Frontend Public Variables (Safe for client browser)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_AGENTS_URL="http://localhost:3003"
NEXT_PUBLIC_INDEXER_URL="http://localhost:3111"
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_PRIVY_APP_ID="your_real_privy_app_id"

# Privy Server Auth
PRIVY_APP_ID="your_real_privy_app_id"
PRIVY_APP_SECRET="your_real_privy_app_secret"

# Internal Service-to-Service Secret
SERVICE_API_KEY="vouchain_internal_service_key_77a9b"
INDEXER_SERVICE_TOKEN="vouchain_indexer_service_token"

# Admin Challenge Resolution Secret (Server Only - User types this in UI modal)
ADMIN_PASSWORD="vouchain_admin_random_secret_replace_this"

# ==============================================================================
# WALLET ROLES & PRIVATE KEYS (0x... 64 hex characters)
# ==============================================================================
