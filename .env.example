# Vouchain (Credent) — Environment Configuration Template
# COPY THIS FILE TO .env IN YOUR LOCAL ENVIRONMENT (GITIGNORED)

# Network Configuration
MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
CHAIN_ID=10143

# Database & Cache Connections
DATABASE_URL="postgres://postgres:password@localhost:5432/vouchain"
REDIS_URL="redis://localhost:6379"

# Service Ports
PORT_FRONTEND=3000
PORT_API=3001
PORT_PLATFORM_SIM=3002
PORT_AGENTS=3003
PORT_INDEXER=3111

# Wallet Roles & Private Keys (0x... 64 hex characters)
# 1. New Platform Attester (Honest SwiftDeliver attester, bonded with 5 MON)
NEW_PLATFORM_ATTESTER_PRIVATE_KEY="0x_your_platform_attester_private_key"

# 2. Red-Team Attester Keys (Rotated for plant false claim testing, bonded with 5 MON each)
REDTEAM_ATTESTER_1_PRIVATE_KEY="0x_your_redteam_attester_1_private_key"
REDTEAM_ATTESTER_2_PRIVATE_KEY="0x_your_redteam_attester_2_private_key"
REDTEAM_ATTESTER_3_PRIVATE_KEY="0x_your_redteam_attester_3_private_key"

# 3. Watcher Wallet (Fraud auditor, funded with 0.5 MON per challenge)
WATCHER_PRIVATE_KEY="0x_your_watcher_private_key"

# 4. Relayer Wallet (Gasless EIP-712 consent relayer)
RELAYER_PRIVATE_KEY="0x_your_relayer_private_key"

# 5. Arbiter Wallet (Deployer key, resolves challenges; SERVER ENV ONLY)
ARBITER_PRIVATE_KEY="0x_your_arbiter_private_key"
ADMIN_PASSWORD="vouchain-admin-secret"

# 6. Platform Payout Wallet (Sends gig payouts and calls repay)
PAYOUT_WALLET_PRIVATE_KEY="0x_your_payout_wallet_private_key"

# Third-Party API Keys
PRIVY_APP_ID="your_privy_app_id"
PRIVY_APP_SECRET="your_privy_app_secret"
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Storage & Pinning
PINATA_JWT="your_pinata_jwt_token"

# Flag to enforce strict on-chain consent verification
STRICT_ONCHAIN_CONSENT="true"
